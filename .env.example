# ============================================
# KTU ELECTION SYSTEM - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ktu_election
DB_PORT=3306

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=4h
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=8080

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=elections@ktu.edu.gh

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_ROUNDS=10
SESSION_TIMEOUT=1800000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ============================================
# ELECTION SETTINGS
# ============================================
ELECTION_NAME=KTU Level 400 Student Election 2026
ELECTION_YEAR=2026
ELECTION_TAGLINE=Your Voice. Your Choice. Your Future.
ELIGIBLE_LEVEL=400

# ============================================
# ADMIN SETTINGS
# ============================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ktu.edu.gh
DEFAULT_ADMIN_PASSWORD=change_me_on_first_login

# ============================================
# BACKUP SETTINGS (Optional)
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * 
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ============================================
# DEBUG & DEVELOPMENT
# ============================================
DEBUG=false
MOCK_DATA=false
